# Solo para `pnpm dev` (servidor de Vite en http://localhost:5173). En Docker no se
# usa: el build recibe VITE_* como build args desde el .env de la raíz
# (.dockerignore excluye estos archivos). Vite da prioridad a .env.local sobre .env.
# Las dos son públicas: quedan dentro del JavaScript (nunca un secreto).

# API directa, sin Caddy (http://localhost:5173 ya está en los orígenes CORS del
# backend, app/middleware/CorsMiddleware.py).
VITE_API_URL=http://localhost:8000

VITE_REHNIMARKET_WHATSAPP=+57****************
