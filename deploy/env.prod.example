# .env de la raíz para el SERVIDOR DE PRODUCCIÓN. Copiar con:
#   cp deploy/env.prod.example .env && chmod 600 .env
# Producción usa el mismo docker-compose.yml y caddy/Caddyfile que el desarrollo
# (deploy/README.md): solo cambia este archivo.
# Valores ficticios: reemplazar <dominio>. Nunca subir el .env real a Git.
# Los secretos (BD, MinIO, JWT, correo) van en .env.postgres, .env.minio y
# RehniMarket-backend/.env (de RehniMarket-backend/.env.public.example), no aquí.
# Ahí también va RATE_LIMIT_ENABLED=true: compose solo pasa al backend las
# variables de este archivo que declara en environment: (servicio backend).
# Generar cada secreto con: openssl rand -hex 32 (marcador CAMBIAR_generar_con_openssl_rand_hex_32).

# Dominios que sirve Caddy. Obligatorios en producción: sin ellos Caddy usa
# localhost y api.localhost (valores de desarrollo). Con un dominio público Caddy
# pide los certificados a Let's Encrypt y redirige HTTP → HTTPS; requiere que el
# DNS apunte al servidor y los puertos 80 y 443 abiertos (§4 del plan).
SITE_ADDRESS=<dominio>
API_ADDRESS=api.<dominio>

# Let's Encrypt necesita 80 y 443: no cambiarlos en producción.
HTTP_PORT=80
HTTPS_PORT=443

# Vacía en producción (si vale local_certs, el navegador no confía en el certificado).
CADDY_LOCAL_CERTS=

# La API directa (sin Caddy) solo escucha en el propio servidor; desde Internet
# se entra por Caddy.
BACKEND_BIND=127.0.0.1
# BACKEND_PORT=8000

# PostgreSQL se publica siempre en 127.0.0.1 (nunca 0.0.0.0): acceso por túnel SSH.
# POSTGRES_PORT=5433

# Público: queda dentro del JavaScript del frontend (nunca un secreto)
VITE_API_URL=https://api.<dominio>
VITE_REHNIMARKET_WHATSAPP=+57**********

# Swagger cerrado en producción
DOCS_ENABLED=false

# Origen del frontend permitido por CORS (la API está en otro dominio)
CORS_EXTRA_ORIGINS=https://<dominio>

# --- Opcionales de docker-compose.yml. Comentadas = valor por defecto de compose ---

# Procesos de Uvicorn del backend (por defecto 3). app/Config.py lo valida entre
# 1 y 16 (fuera de compose, 1).
# UVICORN_WORKERS=3

# Redes de las que Uvicorn acepta X-Forwarded-For para obtener la IP real del
# cliente (por defecto 172.16.0.0/12, las redes de Docker). El límite de
# peticiones cuenta por esa IP.
# FORWARDED_ALLOW_IPS=172.16.0.0/12

# Máximo de clientes que acepta PgBouncer (MAX_CLIENT_CONN) y que el backend usa
# para validar su presupuesto al arrancar. Por defecto 1200 en compose (200 en
# app/Config.py, fuera de compose). Debe ser >= (DB_POOL_SIZE + DB_MAX_OVERFLOW) ×
# UVICORN_WORKERS = (20 + 30) × 3 = 150 con los valores por defecto; si no, el
# backend no arranca.
# PGBOUNCER_MAX_CLIENT_CONN=1200
