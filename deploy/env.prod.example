# .env de la raíz para el SERVIDOR DE PRODUCCIÓN. Copiar con:
#   cp deploy/env.prod.example .env && chmod 600 .env
# Valores ficticios: reemplazar <dominio> y el correo. Nunca subir el .env real a Git.
# Los secretos (BD, MinIO, JWT, correo) van en .env.postgres, .env.minio y
# RehniMarket-backend/.env (de RehniMarket-backend/.env.public.example), no aquí.
# Ahí también va RATE_LIMIT_ENABLED=true: compose no pasa al backend las variables
# de este archivo salvo las de docker-compose.yml:138-143.
# Generar cada secreto con: openssl rand -hex 32 (marcador CAMBIAR_generar_con_openssl_rand_hex_32).

# Dominios que sirve Caddy. Obligatorios: deploy/Caddyfile:43,49 no tiene valor por defecto
# (los de docker-compose.yml:181-182, rehnimarket y api.rehnimarket, son solo para local)
SITE_ADDRESS=<dominio>
API_ADDRESS=api.<dominio>

# Correo del responsable para los certificados de Let's Encrypt
ACME_EMAIL=<correo-del-responsable>

# Caddy publica 80 (aquí) y 443 (deploy/compose.prod.yaml)
FRONTEND_PORT=80

# La API solo escucha en el propio servidor; desde Internet se entra por Caddy
BACKEND_BIND=127.0.0.1
# Puerto del host para la API (docker-compose.yml:146, por defecto 8000)
# BACKEND_PORT=8000

# Público: queda dentro del JavaScript del frontend (nunca un secreto)
VITE_API_URL=https://api.<dominio>
VITE_REHNIMARKET_WHATSAPP=+57**********

# Swagger cerrado en producción
DOCS_ENABLED=false

# Origen del frontend permitido por CORS (la API está en otro dominio)
CORS_EXTRA_ORIGINS=https://<dominio>

# --- Opcionales de docker-compose.yml. Comentadas = valor por defecto de compose ---

# Procesos de Uvicorn del backend (docker-compose.yml:138, por defecto 3; se pasa a
# --workers en :144). app/Config.py:65 lo valida entre 1 y 16 (fuera de compose, 1).
# UVICORN_WORKERS=3

# Redes de las que Uvicorn acepta X-Forwarded-For para obtener la IP real del
# cliente (docker-compose.yml:139, por defecto 172.16.0.0/12, las redes de Docker;
# se pasa a --forwarded-allow-ips en :144). El límite de peticiones cuenta por esa IP.
# FORWARDED_ALLOW_IPS=172.16.0.0/12

# Máximo de clientes que acepta PgBouncer (MAX_CLIENT_CONN, docker-compose.yml:79)
# y que el backend usa para validar su presupuesto al arrancar (:143). Por defecto
# 1200 en compose (200 en app/Config.py:73, fuera de compose). Debe ser >=
# (DB_POOL_SIZE + DB_MAX_OVERFLOW) × UVICORN_WORKERS = (20 + 30) × 3 = 150 con los
# valores por defecto; si no, el backend no arranca (app/Config.py:82).
# PGBOUNCER_MAX_CLIENT_CONN=1200
