# Plantilla del .env único para el SERVIDOR DE PRODUCCIÓN (rehnimarket.duckdns.org).
#   cp deploy/env.prod.example .env && chmod 600 .env
# Mismas variables que .env.example (desarrollo), con los valores de producción. Antes de
# levantar, reemplazar cada valor marcado para cambiar; grep -nE '^[A-Z_]+=.*CAMBIAR' .env no debe mostrar nada.
#   contraseñas y SECRET_KEY: openssl rand -base64 24 | tr '+/' '-_'
#   (sin + ni /, que romperían las URL de conexión). El .env real nunca se sube a Git.
# POSTGRES_PASSWORD se repite dentro de URL_DATABASE y URL_DATABASE_POOLED: los tres deben llevar
# el mismo valor, igual que POSTGRES_USER y POSTGRES_DB.

# ---------------------------------------------------------------- Dominios (Caddy)
# Nombre del frontend. localhost usa la CA local de Caddy; un dominio público, Let's Encrypt.
SITE_ADDRESS=rehnimarket.duckdns.org
# Nombre de la API (reverse proxy al backend).
API_ADDRESS=apirehnimarket.duckdns.org
# Puerto HTTP de Caddy (redirige a HTTPS). Let's Encrypt exige 80.
HTTP_PORT=80
# Puerto HTTPS de Caddy. Si no es 443, las URL llevan el puerto.
HTTPS_PORT=443
# "local_certs" fuerza la CA local con nombres que no son localhost (p. ej. rehnimarket).
CADDY_LOCAL_CERTS=

# ---------------------------------------------------------------- PostgreSQL
# Usuario, contraseña y base. Deben coincidir con los de URL_DATABASE y URL_DATABASE_POOLED.
# Solo se aplican al crear el volumen postgres_data: cambiarlos después no cambia la base.
POSTGRES_USER=rehni_app
POSTGRES_PASSWORD=CAMBIAR_generar_con_openssl_rand_base64_24
POSTGRES_DB=rehnimarket
# Interfaz del host donde se publica PostgreSQL. Nunca 0.0.0.0.
POSTGRES_BIND=127.0.0.1
# Puerto de PostgreSQL en el host (DbSchema; en el servidor, túnel SSH o docker compose exec).
POSTGRES_PORT=5433
# Límite de CPU del contenedor. No puede superar los núcleos del equipo.
POSTGRES_CPUS=1.5

# ---------------------------------------------------------------- PgBouncer
# Clientes que acepta PgBouncer. Debe ser >= (DB_POOL_SIZE + DB_MAX_OVERFLOW) × UVICORN_WORKERS.
PGBOUNCER_MAX_CLIENT_CONN=200

# ---------------------------------------------------------------- MinIO
# Credenciales de MinIO; el backend las usa para leer y guardar archivos.
MINIO_ROOT_USER=rehni_minio
MINIO_ROOT_PASSWORD=CAMBIAR_generar_con_openssl_rand_base64_24
# Dirección de MinIO dentro de la red data de Docker.
MINIO_URL=minio:9000

# ---------------------------------------------------------------- Backend / JWT
# Conexión directa a PostgreSQL (Alembic). Fuera de Docker (uv run): @127.0.0.1:5433.
URL_DATABASE=postgresql://rehni_app:CAMBIAR_generar_con_openssl_rand_base64_24@postgres:5432/rehnimarket
# Conexión de la app por PgBouncer. Sin definir, la app usa URL_DATABASE.
URL_DATABASE_POOLED=postgresql://rehni_app:CAMBIAR_generar_con_openssl_rand_base64_24@pgbouncer:6432/rehnimarket
# Firma de los JWT: cambiarla invalida todas las sesiones.
SECRET_KEY=CAMBIAR_generar_con_openssl_rand_base64_24
# Algoritmo de firma de los JWT.
ALGORITHM=HS256
# Vigencia del token de acceso, en minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Vigencia del token de renovación, en días.
REFRESH_TOKEN_DAYS=15
# URL pública del frontend (enlaces de los correos). Con pnpm dev: http://localhost:5173.
URL_FRONTEND=https://rehnimarket.duckdns.org
# URL pública de la API (base de las URL de imágenes /media/proxy).
URL_BACKEND=https://apirehnimarket.duckdns.org
# Orígenes permitidos por CORS, separados por coma (el frontend está en otro dominio).
CORS_EXTRA_ORIGINS=https://rehnimarket.duckdns.org
# Swagger en /docs, ReDoc y /openapi.json.
DOCS_ENABLED=false
# Límite de peticiones por IP (429 al superarlo).
RATE_LIMIT_ENABLED=true
# Peticiones por IP en cada ventana; por proceso, así que con N workers llega a N × este valor.
REQUEST_LIMIT=100
# Duración de la ventana del límite, en segundos.
TIME_WINDOW=60
# Datos de demo (empresas, productos y la cuenta owner del seed); los roles y los catálogos base se crean siempre.
RUN_SEED=false
# Cuenta admin del seed (vacía: no se crea).
USER_NAME_ADMIN=
ADMIN_DEFAULT=
PASSWORD_DEFAULT=
# Cuenta owner del seed. Vacías en producción: un valor conocido crearía un owner con esa clave.
USER_NAME_OWNER=
OWNER_DEFAULT=
OWNER_PASSWORD_DEFAULT=
# Interfaz del host para la API directa sin Caddy. 0.0.0.0 solo mientras se prueba la app móvil en la LAN.
BACKEND_BIND=127.0.0.1
# Puerto del host para la API directa.
BACKEND_PORT=8000
# Límite de CPU del contenedor backend. No puede superar los núcleos del equipo.
BACKEND_CPUS=2
# Procesos de Uvicorn (1 a 16).
UVICORN_WORKERS=2
# Única IP de la que se acepta X-Forwarded-For: Caddy. Un rango incluiría la pasarela de Docker
# y cualquier proceso del host podría falsear su IP ante el rate limit.
FORWARDED_ALLOW_IPS=172.30.0.10
# Hilos por proceso para los endpoints síncronos. Debe ser <= DB_POOL_SIZE + DB_MAX_OVERFLOW.
THREADPOOL_SIZE=20
# Conexiones fijas del pool de SQLAlchemy por proceso.
DB_POOL_SIZE=10
# Conexiones extra del pool por proceso.
DB_MAX_OVERFLOW=15
# Segundos que una petición espera una conexión libre.
DB_POOL_TIMEOUT=5
# Segundos tras los que se recicla una conexión.
DB_POOL_RECYCLE=1800
# Solo pytest (tests/conftest.py): base desechable de docker compose --profile test.
TEST_DATABASE_URL=

# ---------------------------------------------------------------- SMTP
# Cuenta que envía los correos. Vacía: el sistema arranca, pero no salen los correos.
GMAIL_USERNAME=CAMBIAR_cuenta_de_correo_de_produccion
# Contraseña de aplicación de Google (no se genera con openssl).
GMAIL_APP_PASSWORD=CAMBIAR_contrasena_de_aplicacion_de_Google
# Servidor SMTP. Vacío: Gmail (smtp.gmail.com).
SMTP_HOST=
# Puerto SMTP: 587 STARTTLS, 465 SSL o 2525. Azure bloquea el 25 de salida.
SMTP_PORT=587
# starttls o ssl. Vacío: se deduce del puerto.
SMTP_SECURITY=
# Usuario y contraseña SMTP. Vacíos: GMAIL_USERNAME y GMAIL_APP_PASSWORD.
SMTP_USERNAME=
SMTP_PASSWORD=
# Remitente. Vacío: la cuenta SMTP.
EMAIL_FROM=
# Hilos dedicados al envío de correo.
EMAIL_MAX_WORKERS=4
# Timeout del socket SMTP, en segundos.
SMTP_TIMEOUT=10

# ---------------------------------------------------------------- Frontend
# URL de la API dentro del build de React (pública). Cambiarla exige docker compose up --build.
VITE_API_URL=https://apirehnimarket.duckdns.org
# WhatsApp de recargas que muestra el frontend (público).
VITE_REHNIMARKET_WHATSAPP=
