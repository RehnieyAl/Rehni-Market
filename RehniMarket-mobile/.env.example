# App móvil (Expo). Públicas: quedan dentro del bundle de la app (nunca un secreto).

# API directa del backend en la red local, por HTTP: http://<IP-LAN>:8000.
# Requiere que el .env de la raíz publique la API en la red (BACKEND_BIND con
# 0.0.0.0). El host debe ser el mismo que el de URL_BACKEND en
# RehniMarket-backend/.env: el backend arma con él las URL de las imágenes cuando
# la petición no pasa por Caddy. En producción: https://api.<dominio>.
EXPO_PUBLIC_API_URL=http://<IP-LAN>:8000
EXPO_PUBLIC_REHNIMARKET_WHATSAPP=+57****************
