# .env de la raíz para DESARROLLO LOCAL (docker-compose.yml). Copiar con:
#   cp .env.example .env
# Producción usa el mismo docker-compose.yml y caddy/Caddyfile con otro .env:
# deploy/env.prod.example.

# Dominios que sirve Caddy (caddy/Caddyfile). Con localhost y api.localhost Caddy
# usa su CA local (HTTPS sin configurar nada) y no hace falta /etc/hosts: *.localhost
# resuelve a 127.0.0.1. Para que el navegador no avise, confiar en la raíz de Caddy
# (caddy/caddy-configuracion.md, paso 3.5).
# SITE_ADDRESS=localhost
# API_ADDRESS=api.localhost
#
# Con rehnimarket / api.rehnimarket (guía completa: caddy/caddy-configuracion.md):
# /etc/hosts con los dos nombres en 127.0.0.1, CADDY_LOCAL_CERTS=local_certs, y
# VITE_API_URL=https://api.rehnimarket, CORS_EXTRA_ORIGINS=https://rehnimarket
# (más URL_FRONTEND=https://rehnimarket en RehniMarket-backend/.env).
# SITE_ADDRESS=rehnimarket
# API_ADDRESS=api.rehnimarket

# Puertos de Caddy en el host (por defecto 80 y 443). Si se cambian, las URL
# llevan el puerto (p. ej. https://localhost:8443) y VITE_API_URL también.
# HTTP_PORT=80
# HTTPS_PORT=443

# Opcional: "local_certs" fuerza la CA local de Caddy con cualquier nombre que no
# sea localhost (rehnimarket / api.rehnimarket). Vacía en producción (Let's Encrypt).
# CADDY_LOCAL_CERTS=local_certs

# Público: queda dentro del JavaScript del frontend (nunca un secreto)
VITE_API_URL=https://api.localhost
VITE_REHNIMARKET_WHATSAPP=+57****************

# Origen del frontend permitido por CORS (la API está en otro dominio)
CORS_EXTRA_ORIGINS=https://localhost

# Swagger en https://api.localhost/docs (y http://localhost:8000/docs). En producción, false.
DOCS_ENABLED=false

# Interfaz del host donde se publica la API directa, sin Caddy (por defecto
# 127.0.0.1). 0.0.0.0 la deja accesible desde la red local: la usa la app móvil
# (EXPO_PUBLIC_API_URL=http://<IP-LAN>:8000).
BACKEND_BIND=0.0.0.0
# Puerto del host para la API directa (por defecto 8000).
# BACKEND_PORT=8000

# Puerto de PostgreSQL en el host, siempre en 127.0.0.1 (clientes como DbSchema).
# POSTGRES_PORT=5433

# --- Opcionales de docker-compose.yml. Comentadas = valor por defecto de compose ---

# Procesos de Uvicorn del backend (por defecto 3). app/Config.py lo valida entre
# 1 y 16 (fuera de compose, 1).
# UVICORN_WORKERS=3

# IP de la que Uvicorn acepta X-Forwarded-For para obtener la IP real del cliente:
# solo Caddy, con IP fija 172.30.0.10 en docker-compose.yml (por defecto). El límite
# de peticiones cuenta por esa IP. No usar un rango como 172.16.0.0/12: incluye la
# pasarela de Docker (172.30.0.1), por la que llega lo que entra al :8000 desde el
# propio equipo, y con ella cualquiera podría falsear su IP.
# FORWARDED_ALLOW_IPS=172.30.0.10

# Máximo de clientes que acepta PgBouncer (MAX_CLIENT_CONN) y que el backend usa
# para validar su presupuesto al arrancar. Por defecto 1200 en compose (200 en
# app/Config.py, fuera de compose). Debe ser >= (DB_POOL_SIZE + DB_MAX_OVERFLOW) ×
# UVICORN_WORKERS = (20 + 30) × 3 = 150 con los valores por defecto; si no, el
# backend no arranca.
# PGBOUNCER_MAX_CLIENT_CONN=1200
