# Copiar a .env.postgres. Lo leen postgres y pgbouncer.
# Deben coincidir con URL_DATABASE* de RehniMarket-backend/.env.
POSTGRES_USER="CAMBIA_USUARIO"
# Secreto. Generar con: openssl rand -hex 32 (uno propio por entorno; en
# producción no reutilizar el de desarrollo). El mismo valor va en la contraseña
# de URL_DATABASE y URL_DATABASE_POOLED de RehniMarket-backend/.env.
POSTGRES_PASSWORD="CAMBIAR_generar_con_openssl_rand_hex_32"
POSTGRES_DB="CAMBIA_BD"
