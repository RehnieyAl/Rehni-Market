# RehniMarket-backend/.env para el SERVIDOR DE PRODUCCIÓN. Copiar con:
#   cp RehniMarket-backend/.env.public.example RehniMarket-backend/.env && chmod 600 RehniMarket-backend/.env
# Todo valor CAMBIAR_* es un marcador: el backend arranca con él, así que hay
# que reemplazarlo antes de levantar los servicios. Generar cada secreto con:
#   openssl rand -hex 32
# Un valor distinto por secreto y por entorno: nunca reutilizar los de desarrollo.

# La contraseña de las dos URL es POSTGRES_PASSWORD de .env.postgres (el mismo
# valor generado con openssl rand -hex 32; en hexadecimal no hace falta escaparlo).
URL_DATABASE="postgresql://rehni_prod:CAMBIAR_generar_con_openssl_rand_hex_32@postgres:5432/rehnimarket"
# Usada por app/database/Connection.py:16 (tráfico normal de la app): pasa por PgBouncer
# (puerto 6432) en vez de ir directo a Postgres. Si no se define, la app usa
# URL_DATABASE (app/Config.py:28). Alembic sigue usando URL_DATABASE (directo).
URL_DATABASE_POOLED="postgresql://rehni_prod:CAMBIAR_generar_con_openssl_rand_hex_32@pgbouncer:6432/rehnimarket"

# Firma de los JWT. Generar con: openssl rand -hex 32
SECRET_KEY="CAMBIAR_generar_con_openssl_rand_hex_32"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_DAYS=15

GMAIL_USERNAME="notificaciones@tu-dominio.com"
# No se genera con openssl: es una contraseña de aplicación que emite Google
# (cuenta con verificación en dos pasos > Seguridad > Contraseñas de aplicaciones).
# Crear una propia para producción, distinta de la de desarrollo.
GMAIL_APP_PASSWORD="CAMBIAR_contrasena_de_aplicacion_de_Google"

URL_FRONTEND="https://tu-dominio.com"
URL_BACKEND="https://api.tu-dominio.com"

MINIO_URL=minio:9000

RATE_LIMIT_ENABLED=true
# Opcionales; solo actúan con RATE_LIMIT_ENABLED=true (app/main.py:110).
# Comentadas = valor por defecto del código. El contador es en memoria y por
# proceso: con N workers de Uvicorn, cada IP puede llegar a N × REQUEST_LIMIT.
# Máximo de peticiones por IP dentro de la ventana; al superarlo responde 429
# (app/Config.py:57, por defecto 100; app/middleware/RateLimitMiddleware.py:35).
# REQUEST_LIMIT=100
# Duración de la ventana en segundos (app/Config.py:58, por defecto 60;
# app/middleware/RateLimitMiddleware.py:32).
# TIME_WINDOW=60

# Cuentas del seed. Solo se usan con RUN_SEED=true (app/main.py:52), que en
# producción queda en false. Se dejan vacías a propósito, sin marcador: un
# marcador conocido crearía la cuenta owner con esa contraseña si alguien activa
# el seed (app/utils/seed.py:1655 la omite solo si algún campo está vacío).
# Si se llegan a usar, generar las contraseñas con: openssl rand -hex 32
USER_NAME_ADMIN=""
ADMIN_DEFAULT=""
PASSWORD_DEFAULT=""
USER_NAME_OWNER=""
OWNER_DEFAULT=""
OWNER_PASSWORD_DEFAULT=""

RUN_SEED=false
