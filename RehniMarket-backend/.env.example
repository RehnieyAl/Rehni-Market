# RehniMarket-backend/.env para DESARROLLO LOCAL. Copiar con:
#   cp RehniMarket-backend/.env.example RehniMarket-backend/.env && chmod 600 RehniMarket-backend/.env
# Producción: RehniMarket-backend/.env.public.example (mismas claves). Solo de
# desarrollo son los valores de RATE_LIMIT_ENABLED (false), URL_FRONTEND y
# URL_BACKEND (localhost) y RUN_SEED (se puede activar en local).
# Usuario, contraseña y base de las dos URL: los mismos de .env.postgres
# (POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_DB).
URL_DATABASE="postgresql://CAMBIA_USUARIO:CAMBIA_CLAVE@postgres:5432/CAMBIA_BD"
# Conexión de la app en tiempo de ejecución a través de PgBouncer
# (app/database/Connection.py:16); docker-compose.yml siempre trae PgBouncer.
# Si no se define, la app usa URL_DATABASE (app/Config.py:28): comentarla solo
# con el backend fuera de compose (uv run, sin PgBouncer). Alembic siempre usa
# URL_DATABASE (conexión directa).
URL_DATABASE_POOLED="postgresql://CAMBIA_USUARIO:CAMBIA_CLAVE@pgbouncer:6432/CAMBIA_BD"

SECRET_KEY="REEMPLAZAR_POR_openssl_rand_hex_32"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_DAYS=15

GMAIL_USERNAME="tu-correo@gmail.com"
GMAIL_APP_PASSWORD="contraseña-de-aplicacion-de-gmail"

# Frontend detrás de Caddy (enlaces de los correos). Con pnpm dev: http://localhost:5173
URL_FRONTEND="https://localhost"
# API directa (sin Caddy): base de las URL de imágenes cuando la petición no pasa por
# Caddy (app móvil en la red local: http://<IP-LAN>:8000).
URL_BACKEND="http://localhost:8000"

MINIO_URL=minio:9000

RATE_LIMIT_ENABLED=false
# Opcionales; solo actúan con RATE_LIMIT_ENABLED=true (app/main.py:110).
# Comentadas = valor por defecto del código. El contador es en memoria y por
# proceso: con N workers de Uvicorn, cada IP puede llegar a N × REQUEST_LIMIT.
# Máximo de peticiones por IP dentro de la ventana; al superarlo responde 429
# (app/Config.py:57, por defecto 100; app/middleware/RateLimitMiddleware.py:35).
# REQUEST_LIMIT=100
# Duración de la ventana en segundos (app/Config.py:58, por defecto 60;
# app/middleware/RateLimitMiddleware.py:32).
# TIME_WINDOW=60

USER_NAME_ADMIN=""
ADMIN_DEFAULT=""
PASSWORD_DEFAULT=""

USER_NAME_OWNER=""
OWNER_DEFAULT=""
OWNER_PASSWORD_DEFAULT=""

RUN_SEED=false

# Solo pytest (tests/conftest.py), no la lee la app: BD de pruebas que se crea y
# se borra en cada ejecución. Con el servicio postgres-test de docker-compose.yml
# (docker compose --profile test up -d --wait postgres-test):
# TEST_DATABASE_URL=postgresql://rehni_test:rehni_test@127.0.0.1:55433/rehnimarket_test

# --- Ajustes de rendimiento (opcionales) ---
# Comentadas = valor por defecto de app/Config.py:65-73,91-92. El backend no
# arranca si no se cumplen estas dos reglas (app/Config.py:76-87):
#   DB_POOL_SIZE + DB_MAX_OVERFLOW >= THREADPOOL_SIZE
#   (DB_POOL_SIZE + DB_MAX_OVERFLOW) × UVICORN_WORKERS <= PGBOUNCER_MAX_CLIENT_CONN
# (UVICORN_WORKERS y PGBOUNCER_MAX_CLIENT_CONN van en el .env de la raíz.)
# Los endpoints son síncronos: corren en un threadpool de THREADPOOL_SIZE hilos
# por proceso, y una petición puede retener su conexión después de liberar el
# hilo; por eso el pool de conexiones debe ser mayor que el threadpool.
# THREADPOOL_SIZE=40
# Conexiones fijas y extra del pool de SQLAlchemy por proceso.
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=30
# Segundos que una petición espera una conexión libre antes de fallar.
# DB_POOL_TIMEOUT=5
# Segundos tras los que se recicla una conexión.
# DB_POOL_RECYCLE=1800
# Hilos dedicados al envío de correo y timeout del socket SMTP (segundos).
# EMAIL_MAX_WORKERS=4
# SMTP_TIMEOUT=10
