# Variante SOLO PARA PRUEBA LOCAL de HTTPS (semana 3 del plan de implantación).
# No reemplaza a `Caddyfile`: lo importa completo (snippet `frontend` y sitios http://)
# y añade los mismos dos sitios en HTTPS con la CA interna de Caddy (`tls internal`).
#
# Se activa con el override docker-compose.tls-local.yml:
#   docker compose -f docker-compose.yml -f docker-compose.override.yml \
#     -f docker-compose.tls-local.yml up -d
#
# Los certificados los firma la CA local de Caddy (volumen caddy_data): el navegador
# no confía en ella, por eso la prueba se hace con `curl -k --resolve`.
# En producción con dominio público se usa un correo ACME (Let's Encrypt) en lugar
# de `tls internal`; ver la sección 4.5 del plan de implantación.

import Caddyfile

{$SITE_ADDRESS:rehnimarket} {
	tls internal
	import frontend
}

{$API_ADDRESS:api.rehnimarket} {
	tls internal
	encode zstd gzip
	reverse_proxy backend:8000
}
