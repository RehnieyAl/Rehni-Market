# Caddyfile único: desarrollo y producción. Lo monta docker-compose.yml en el servicio
# `frontend` (Caddy sirve el build de React y hace de reverse proxy de la API).
#
# Variables (.env de la raíz; docker-compose.yml las pasa al contenedor):
#   SITE_ADDRESS       dominio del frontend   local: localhost       producción: <dominio>
#   API_ADDRESS        dominio de la API      local: api.localhost   producción: api.<dominio>
#   HTTP_PORT          puerto HTTP  (por defecto 80)
#   HTTPS_PORT         puerto HTTPS (por defecto 443). En producción, 80 y 443: Let's Encrypt los necesita.
#   CADDY_LOCAL_CERTS  opcional; "local_certs" fuerza la CA local con cualquier nombre
#                      (prueba de la semana 3 con rehnimarket / api.rehnimarket). Vacía en producción.
#
# Sin prefijo http://, Caddy activa el HTTPS automático y elige el emisor según el nombre:
#   - localhost, *.localhost o una IP: su CA local (equivale a `tls internal`).
#   - un dominio público: Let's Encrypt. Requiere que el DNS apunte al servidor y que
#     los puertos 80 y 443 estén abiertos (sección 4 del plan de implantación).
# En los dos casos redirige HTTP → HTTPS.
{
	http_port {$HTTP_PORT:80}
	https_port {$HTTPS_PORT:443}
	{$CADDY_LOCAL_CERTS}
}

(frontend) {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	root * /srv

	# Archivos con hash del build de Vite: caché de un año
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Rutas de React: si el archivo no existe, index.html y el router decide
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

{$SITE_ADDRESS:localhost} {
	import frontend
}

# El backend arma las URL de imágenes con el host por el que llegó el cliente
# (X-Forwarded-Host, ver PublicBaseUrlMiddleware).
{$API_ADDRESS:api.localhost} {
	encode zstd gzip
	reverse_proxy backend:8000
}

# Healthcheck del contenedor: puerto interno, no se publica en el host.
http://:8081 {
	respond "ok" 200
}
