{
  "name": "ramas-main-develop",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": { "include": ["refs/heads/main", "refs/heads/develop"], "exclude": [] }
  },
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": ["merge", "squash"]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "backend", "integration_id": 15368 },
          { "context": "frontend", "integration_id": 15368 },
          { "context": "auditoria", "integration_id": 15368 },
          { "context": "mobile", "integration_id": 15368 },
          { "context": "dependencias", "integration_id": 15368 },
          { "context": "rama-origen", "integration_id": 15368 }
        ]
      }
    }
  ]
}
